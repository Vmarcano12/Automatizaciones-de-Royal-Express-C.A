    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// =========================================================================\n// MODO DE RESPALDO:\n// true  = RESPALDO COMPLETO INICIAL (Sube TODOS los archivos que existan).\n// false = RESPALDO DIARIO INCREMENTAL (Solo sube lo modificado en las últimas 24h).\n// =========================================================================\nconst RESPALDO_COMPLETO_INICIAL = false;\n\nconst ahora = new Date();\nconst limite24h = new Date(ahora.getTime() - (24 * 60 * 60 * 1000));\n\nlet listaArchivos = [];\nfor (const item of items) {\n  const data = item.json;\n  if (data && Array.isArray(data.value)) {\n    listaArchivos = listaArchivos.concat(data.value);\n  } else if (data && data.id) {\n    listaArchivos.push(data);\n  }\n}\n\nconst archivosValidos = listaArchivos.filter(f => f.file && f.id);\n\nlet modificados = [];\nif (RESPALDO_COMPLETO_INICIAL) {\n  modificados = archivosValidos;\n} else {\n  modificados = archivosValidos.filter(f => {\n    if (!f.lastModifiedDateTime) return false;\n    const fechaMod = new Date(f.lastModifiedDateTime);\n    return fechaMod >= limite24h;\n  });\n}\n\nif (modificados.length === 0) {\n  return [{ json: { hayArchivos: false, totalModificados: 0, cuenta: 'MTTO' } }];\n}\n\nreturn modificados.map(f => {\n  let rutaRelativa = f.name;\n  if (f.parentReference && f.parentReference.path) {\n    const partes = f.parentReference.path.split(':');\n    if (partes.length > 1 && partes[1]) {\n      const carpeta = partes[1].replace(/^\\/+/, '');\n      if (carpeta) {\n        rutaRelativa = `${carpeta}/${f.name}`;\n      }\n    }\n  }\n  return {\n    json: {\n      id: f.id,\n      name: f.name,\n      size: f.size,\n      lastModifiedDateTime: f.lastModifiedDateTime,\n      rutaDestino: rutaRelativa,\n      cuenta: 'MTTO',\n      hayArchivos: true\n    }\n  };\n});"
      },
